# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Runtime vault (created on first run)
SerenityVault/
*.serenity-vault/

